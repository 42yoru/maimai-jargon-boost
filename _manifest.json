{
  "manifest_version": 2,
  "version": "0.3.2",
  "name": "黑话加速器",
  "description": "给消息量不大的麦麦准备的黑话加速插件：不改主程序，把已经有足够证据、但还没到推断阈值的黑话记录 count 提前补到首推档，让主程序自己的三段推断完成确认。",
  "author": {
    "name": "42yoru",
    "url": "https://github.com/42yoru"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/42yoru/maimai-jargon-boost",
    "homepage": "https://github.com/42yoru/maimai-jargon-boost",
    "documentation": "https://github.com/42yoru/maimai-jargon-boost/blob/main/README.md",
    "issues": "https://github.com/42yoru/maimai-jargon-boost/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "database.query",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "zap",
      "background": "#FFD69A"
    }
  },
  "plugin_type": "knowledge",
  "id": "github.42yoru.maimai-jargon-boost"
}
